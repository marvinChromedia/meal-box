# Base URL the frontend sends API requests to (no trailing slash).
VITE_API_BASE_URL=http://localhost:4000/api

# "http" sends real requests to VITE_API_BASE_URL (default, now that the recipe
# and shopping-list endpoints exist). "mock" serves feature data from in-memory
# typed fixtures instead — useful for building a screen ahead of its endpoints.
VITE_API_MODE=http
